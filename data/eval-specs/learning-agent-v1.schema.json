{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evals.zenheart.site/schemas/learning-agent-v1.json",
  "title": "Learning Agent Evaluation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact",
    "spec",
    "subject",
    "source_snapshot",
    "run",
    "results",
    "evidence"
  ],
  "properties": {
    "artifact": {
      "const": "learning-agent-eval"
    },
    "spec": {
      "const": "eval-spec-v1"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "captured_at",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "captured_at": {
          "type": "string",
          "format": "date"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "locator",
              "sha256",
              "access"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "access": {
                "type": "string",
                "enum": [
                  "public",
                  "synthetic",
                  "restricted"
                ]
              }
            }
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed",
        "model",
        "prompt_hash"
      ],
      "properties": {
        "seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "name",
            "revision"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "prompt_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retrieval",
        "grounding",
        "safety",
        "reliability",
        "learning"
      ],
      "properties": {
        "retrieval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "hit_rate",
            "mrr"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "deterministic-file",
                "hybrid",
                "vector"
              ]
            },
            "hit_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "mrr": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "grounding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "citation_precision",
            "unsupported_claim_rate",
            "abstention_quality"
          ],
          "properties": {
            "citation_precision": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "unsupported_claim_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "abstention_quality": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "safety": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "acl_leakage_rate",
            "injection_resistance",
            "pii_redaction"
          ],
          "properties": {
            "acl_leakage_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "injection_resistance": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "pii_redaction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "reliability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "replay_pass",
            "idempotency_pass",
            "timeout_retry_pass"
          ],
          "properties": {
            "replay_pass": {
              "type": "boolean"
            },
            "idempotency_pass": {
              "type": "boolean"
            },
            "timeout_retry_pass": {
              "type": "boolean"
            }
          }
        },
        "learning": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "explain",
            "perform",
            "debug",
            "transfer",
            "retain"
          ],
          "properties": {
            "explain": {
              "type": "string",
              "enum": [
                "pass",
                "fail",
                "pending"
              ]
            },
            "perform": {
              "type": "string",
              "enum": [
                "pass",
                "fail",
                "pending"
              ]
            },
            "debug": {
              "type": "string",
              "enum": [
                "pass",
                "fail",
                "pending"
              ]
            },
            "transfer": {
              "type": "string",
              "enum": [
                "pass",
                "fail",
                "pending"
              ]
            },
            "retain": {
              "type": "string",
              "enum": [
                "pass",
                "fail",
                "pending"
              ]
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "traces",
        "failing_cases",
        "reviewer"
      ],
      "properties": {
        "traces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "failing_cases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reviewer": {
          "type": "string",
          "enum": [
            "human",
            "automated",
            "mixed"
          ]
        }
      }
    }
  }
}

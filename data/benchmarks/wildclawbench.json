    "construction": [
      {
        "k": "出题",
        "text": "8 名研究员耗时 2 周，逐题手工撰写任务说明、参考解与评分标准；不从既有基准改编，也不用模板自动生成。",
        "cite": [
          "paper-arxiv@§3.3",
          "leaderboard-site@首页"
        ]
      },
      {
        "k": "评分函数与过滤",
        "text": "每题配一个可执行评分函数，返回逐条指标分与聚合分；作者用 Δ_ij ≥ 0.2 的难度区分度筛题，保证同一模型能拉开差距。",
        "cite": [
          "paper-arxiv@§3.4",
          "paper-arxiv@§3.3"
        ]
      },
      {
        "k": "运行时隔离与防泄漏",
        "text": "每题在独立 Docker 容器里从固定工作区初始化；ground truth 与评分脚本在 agent 退出后才挂载，执行期不可见；同一套结果跨机器可复现。",
        "cite": [
          "paper-arxiv@§3.4",
          "repo-wildclawbench@README"
        ]
      },
      {
        "k": "混合判分",
        "text": "每题评分函数最多组合三类检查：确定性规则检查、环境状态审计（instrumented 服务的审计日志 + 安全任务的 transcript）、以及 LLM/VLM 裁判（默认 GPT 5.4）。",
        "cite": [
          "paper-arxiv@§3.4",
          "paper-arxiv@§4.1"
        ]
      }
    ]
  },

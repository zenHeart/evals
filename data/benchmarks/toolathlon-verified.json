  "limitations": [
    {
      "issue": "跨版本成绩不可比",
      "impact": "Verified 改了指令、初始状态、标准答案、评测器和执行基础设施，与此前的 Toolathlon 成绩是两条独立序列；把两者排在一起会得出错误的模型进步或退步结论。",
      "severity": "高",
      "response": "官方在榜单页明确标注 Verified 开启新分数序列，并保留一份 Verified 之前的归档快照供历史对照。",
      "reader": "只在同一序列内比较；引用成绩时必须写清是 Verified 还是原始发布，以及评测日期。",
      "cite": [
        "leaderboard@表头说明",
        "blog-verified@A new Verified baseline"
      ]
    },
    {
      "issue": "外部真实服务噪声",
      "impact": "任务跑在真实应用与 API 上，写入成功和立刻可读不是同一件事；外部服务抖动从外部看像 agent 能力不足。",
      "severity": "中",
      "response": "Verified 加入有界超时与重试、43 个评测器改用共享的有界整检重试、就绪探针，并按实例命名空间隔离容器。",
      "reader": "单次失败先怀疑环境；官方误差棒只覆盖三次运行间方差，不覆盖外部服务抖动。",
      "cite": [
        "blog-verified@External-service failures",
        "blog-verified@Evaluation visibility"
      ]
    },
    {
      "issue": "Pass@3 / Pass³ 与 Pass@1 差距大",
      "impact": "Pass@3（至少一次对）会高估可靠性；论文明确指出 Pass@3 与 Passˆ3 差距显著，说明很多模型有能力覆盖但缺乏稳定复现。",
      "severity": "中",
      "response": "官方同时报告 Pass@1、Pass@3、Pass³ 与 AvgTurns，并开放原始轨迹供复查。",
      "reader": "评估可靠性优先看 Pass³；只引 Pass@3 会显著高估。",
      "cite": [
        "arxiv-2510-25726@§4.2 Main Results",
        "hf-traj@指标定义"
      ]
    },
    {
      "issue": "采样参数不统一",
      "impact": "官方不设 temperature / top-p，沿用各模型提供方默认值；不同提供方的默认采样参数不同，成绩差异里混入了提供方配置差异。",
      "severity": "中",
      "response": "官方在仓库 Evaluation Defaults 中明确说明这一点。",
      "reader": "跨厂商比较时把这视为一个未受控变量。",
      "cite": [
        "repo-toolathlon@Evaluation Defaults"
      ]
    },
    {
      "issue": "轨迹数据集受门控且禁训练",
      "impact": "HF 上的 Toolathlon-Verified_Trajectories 是 gated 数据集，明确禁止用于预训练、继续预训练、SFT、偏好 / RL 后训练、蒸馏、合成训练数据或检索语料，也禁止公开镜像与再分发。",
      "severity": "低",
      "response": "数据集卡声明仅用于评测、复现、审计与错误分析，并带 canary GUID 与机器可读的污染治理元数据；打包前已扫描并脱敏凭据。",
      "reader": "不要把轨迹当训练数据；二次分发前自行复核脱敏。",
      "cite": [
        "hf-traj@污染声明"
      ]
    },
    {
      "issue": "基准需要持续维护",
      "impact": "任务依赖的真实应用、API、数据源与认证体系会继续变化；新模型可能走出现有评测器还没覆盖的有效解法。",
      "severity": "低",
      "response": "官方表示会持续调查可复现失败、区分基准缺陷与 agent 错误，并在证据充分时更新 Verified 序列。",
      "reader": "把 Toolathlon 当作需要维护的测量系统，而不是一次性的静态题集；关注版本日期。",
      "cite": [
        "blog-verified@Limitations and what comes next"
      ]
    }
  ],
  "notes": "Toolathlon-Verified 与 Toolathlon 是同一批 108 题的两个发布版本，不是子集关系；官方明确无任务增删或改名。Meta 的 Muse Spark 1.1 / 1.2 也在官方 Verified 榜上（均带独立评测徽章），仓库 News 记录 2026-07-09 上传了 Muse Spark 1.1 的轨迹。HF 上另有 gated 的 Toolathlon-Verified_Trajectories 数据集（12 个模型）。",

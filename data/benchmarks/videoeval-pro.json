{
  "id": "videoeval-pro",
  "name": "VideoEval-Pro",
  "full_name": "VideoEval-Pro: Robust and Realistic Long Video Understanding Evaluation（稳健真实的长视频理解评测）",
  "aliases": [],
  "status": null,
  "categories": [
    "multimodal"
  ],
  "summary": "VideoEval-Pro 是把 Video-MME、MLVU、LVBench、LongVideoBench 四个长视频基准里的多选题改写成开放式短答题的长视频理解（LVU）基准：1,289 道题来自 465 条平均 38.25 分钟的真实视频，答题时只给问题、不给选项。",
  "interpretation": "分数是 GPT-4o-0806 把回答判为 Correct 的比例（0–100%）。同一批题加回选项后所有模型落差超过 25%，所以这里的绝对分天然低于同源多选题基准，分低不等于模型看不懂视频；论文还明确 MCQ 排名与开放式排名不必然相关，两个榜不能互相印证。",
  "measures": [
    {
      "area": "局部分段感知（Local Perception, LP）",
      "focus": "在一条长视频里定位并识别某个短片段中的视觉元素或动作，例如「视频开头那个人骑的是什么车」。",
      "share": "59%",
      "format": "开放式短答（全库答案平均 2.1 词）",
      "cite": [
        "paper@§3.2",
        "paper@§4.4"
      ]
    },
    {
      "area": "局部分段推理（Local Reasoning, LR）",
      "focus": "在短时间窗内做推理：因果、时序先后、局部事件的变化。",
      "share": "11%",
      "format": "开放式短答",
      "cite": [
        "paper@§3.2"
      ]
    },
    {
      "area": "全片感知（Holistic Perception, HP）",
      "focus": "需要看完整条视频才能数的计数题，例如「视频里一共出现多少人」。",
      "share": "10%",
      "format": "开放式短答",
      "cite": [
        "paper@§3.2",
        "paper@§4.4"
      ]
    },
    {
      "area": "全片推理（Holistic Reasoning, HR）",
      "focus": "跨事件、跨场景的高层理解，常涉及叙事与意图。",
      "share": "21%",
      "format": "开放式短答",
      "cite": [
        "paper@§3.2"
      ]
    }
  ],
  "does_not_measure": [
    {
      "text": "不测「蒙对选项」的能力：题目不给选项，也不报 SimpleQA / Video-SimpleQA 系的 F-score（Correct 与 Given-Attempted Correct 的调和平均），只看整体 Correct 比例。",
      "cite": [
        "paper@§3.3"
      ]
    },
    {
      "text": "不测短视频或单帧理解：所有源视频都超过 10 分钟，论文还用「随机抽一帧能否答对」当难度过滤器；五个受测模型单帧只有约 10%。",
      "cite": [
        "paper@§3.2",
        "paper@§4.3"
      ]
    },
    {
      "text": "不测依赖选项提示、时间戳或字幕的问答：模型只拿到问题本身和均匀采样的帧。",
      "cite": [
        "paper@§3.1",
        "paper@§3.3"
      ]
    }
  ],
  "dataset": {
    "sample_count": 1289,
    "splits": [
      "test：官方只发布一个拆分（HF 上 1.29k 行），无 train / val"
    ],
    "languages": [
      "en"
    ],
    "source_type": "真实长视频 + 由四个既有 MCQ 基准改写的开放式短问答",
    "public_sample": true,
    "totals": "465 条视频、1,289 道开放式短答题；平均视频长 38.25 分钟，其中 204 条在 10–30 分钟、261 条超过 30 分钟；371 题对应 10–30 分钟的视频、918 题对应更长的视频；答案平均 2.1 词。HF 上以单个 test 拆分发布，1,289 行、约 150 GB。",
    "cite": [
      "paper@§3.2",
      "dataset"
    ],
    "construction": [
      {
        "k": "选题来源",
        "text": "从 Video-MME、MLVU、LVBench、LongVideoBench 四个长视频 MCQ 基准取题，种子集共 5,562 道多选题（4–6 个选项），统一改写成自由形式问答。",
        "cite": [
          "paper@§3.1"
        ]
      },
      {
        "k": "去掉选项",
        "text": "原 MCQ 的正确项直接作为参考答案，干扰项全部丢弃；模型只收到问题本身，只能依据视频作答，不能从选项之间的差异里找线索。",
        "cite": [
          "paper@§3.1"
        ]
      },
      {
        "k": "时长过滤",
        "text": "剔除所有源视频短于 10 分钟的样本。",
        "cite": [
          "paper@§3.1"
        ]
      },
      {
        "k": "答案长度过滤",
        "text": "剔除原多选题选项平均词数超过 5 词的题目，避免参考答案过长。",
        "cite": [
          "paper@§3.1"
        ]
      },
      {
        "k": "可答性与难度过滤",
        "text": "用 Gemini-2.0-Flash 做两轮筛选：先排除仅凭视频内容答不出的题；再从每个视频随机抽一帧让它同时答 MCQ 与开放式版本，两种格式都答对的题直接剔除。",
        "cite": [
          "paper@§3.1"
        ]
      }
    ]
  },
  "default_protocol": {
    "raw": "从每个视频均匀采样固定数量的帧喂给模型；判分沿用 SimpleQA 与 Video-SimpleQA 的标准，把回答分成 Correct / Incorrect / Not Attempted 三档，裁判走 LLM-as-a-Judge 范式、具体版本为 GPT-4o-0806；主分数是全库被判 Correct 的比例（0–100%），不报 F-score。模型与裁判都用贪心解码（temperature 0）。论文对每个模型分别试 32 / 64 / 128 / 256 / 512 帧并取最高分。",
    "cite": [
      "paper@§3.3",
      "paper@§4.1"
    ],
    "variants": [
      {
        "text": "开放式 vs 多选题对照：论文会把原始选项还给模型再跑一遍 MCQ，此时改用精确字符串匹配算准确率；两个口径不可直接比较。",
        "cite": [
          "paper@§4.1",
          "paper@§4.2"
        ]
      },
      {
        "text": "帧数预算不固定：各模型取自己 32–512 帧里的最高分，帧数多的模型占优，榜单不是同一算力下的对比；只看一帧时所有模型约 10%。",
        "cite": [
          "paper@§4.1",
          "paper@§4.3"
        ]
      },
      {
        "text": "裁判版本命名不一致：论文写 GPT-4o-0806，HF 数据集卡写 gpt-4o-2024-08-06，是同一模型的不同写法；论文也提醒该版本可能过期或不可访问。",
        "cite": [
          "paper@§3.3",
          "dataset",
          "paper@附录 A"
        ]
      }
    ]
  },

  "benchmarks": {
    "terminalbench": {
      "name": "Terminal-Bench",
      "measures": "真实终端环境任务（git/npm/docker/数据处理），测 CLI 动手操作",
      "does_not_measure": "不能代表前端业务代码设计与交互逻辑细节；需结合具体技术栈复核。",
      "language_scope": "命令行/Shell/Docker 工具调用",
      "comparison": "cross_model",
      "reason": "仅在指标、版本及完整执行沙箱协议相同的条件下比较。",
      "unit": "percent",
      "metric": "resolve_rate",
      "min": 0,
      "max": 100,
      "direction": "higher",
      "source_urls": [
        "https://t-bench.com"
      ],
      "data_date": "2026-09-01"
    },
    "swebench-pro": {
      "name": "SWE-bench Pro",

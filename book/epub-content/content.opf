<package xmlns="http://www.idpf.org/2007/opf" version="3.0" unique-identifier="bookid" xml:lang="zh-CN">
  <metadata xmlns:dc="http://purl.org/dc/elements/1.1/">
    <dc:identifier id="bookid">urn:uuid:evals-handbook-2026-v1</dc:identifier>
    <dc:title>大模型评估入门：从前端工程师视角看 Eval</dc:title>
    <dc:creator>ZenHeart</dc:creator>
    <dc:language>zh-CN</dc:language>
    <dc:date>2026-08-28</dc:date>
    <dc:description>一本面向初级前端工程师的大模型评估入门电子书。从软件测试的视角切入，让读者只通过本书就能完全理解 LLM 评估的标准流程、核心原理、主流基准、厂商报告解读、评估工程实践与自定义评估设计。</dc:description>
